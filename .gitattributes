# Normalise text so the repo behaves the same on every machine.
* text=auto eol=lf

# Binary assets must never be line-ending translated. The qinghua point clouds
# are raw Float32/Uint8 buffers — a CRLF rewrite would silently corrupt them.
*.bin binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.ttf binary

# Generated media is committed on purpose (EdgeOne builds straight from the
# repo), but it should not dominate diffs or merge statistics.
public/works/** linguist-generated=true
public/qinghua/*.bin linguist-generated=true

# Lockfiles: keep them, but out of the way when reading history.
package-lock.json linguist-generated=true -diff

# The changelog is append-at-the-top: two branches adding an entry at the same
# spot is the normal case, not a real conflict. Union-merge keeps both entries
# instead of leaving conflict markers in a file whose whole job is to be read.
CHANGELOG.md merge=union
